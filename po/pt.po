#: camorama.appdata.xml.in:7 camorama.desktop.in:4
msgid "Camorama Webcam Viewer"
msgstr "Camorama - Visualizador de Câmara da Web"

#: camorama.appdata.xml.in:9
msgid ""
"Camorama is a simple webcam viewer, with the ability to apply some video "
"effects."
msgstr ""
"Camorama é um visualizador de câmara da Web simplificado, com a capacidade "
"para aplicar alguns efeitos de vídeo."

